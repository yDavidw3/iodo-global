<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Conta Iodo Global | Login</title>
    <link rel="stylesheet" href="/login.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>
<body>
    <div class="stackContainer1">
        <div class="layoutContainer">
            <main>
                <div class="layoutContent">
                    <header class="emailStep">
                        <div class="stackContainer2">
                            <header class="headerRoot">
                                <h1 class="brandLogo">Conta<strong class="brandLogoMark">IG</strong></h1>
                                <h3 class="headingH3">
                                    Uma só conta para todos
                                    <br>
                                    os produtos IG. <strong>É grátis</strong>
                                </h3>
                            </header>
                            <img src="" alt="Produtos IG" class="bannerImg">
                        </div>
                        <div class="hiddenContainer">
                            <h1>Login informe seu email</h1>
                        </div>
                    </header>
                    <div class="stackContainer2">
                        <div class="stackContainer3">
                            <form action="">
                                <div class="stackContainer3">
                                    <div class="stackContainer4">
                                        <div class="stackContainer5">
                                            <label for="" class="inputLabel"></label>
                                            <p class="textStyled">Informe o seu e-mail</p>
                                        </div>
                                        <div class="inputContainer">
                                            <input type="text" placeholder="Ex: @gmail, @outlook, @yahoo, etc.">
                                        </div>
                                    </div>
                                </div>
                            </form>
                            <button type="submit" class="baseButton primaryButton">
                                <span>Continuar</span>
                            </button>
                        </div>
                        <div class="stackContainer2">
                            <div class="stackContainer6">
                                <p class="styledText">Ou escolha uma opção:</p>
                                <div class="stackContainer7">
                                    <button class="baseButton buttonSocial">
                                        <i class="bi bi-google"></i>
                                    </button>
                                    <button class="baseButton buttonSocial">
                                        <i class="bi bi-facebook"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="stackContainer2">
                                <div class="stackContainer2">
                                    <p class="styledText">
                                        <span class="emailStepFooter">
                                            Não tem conta?
                                            <br>
                                        </span>
                                        <a href="/cadastro" class="styledLink">
                                            Criar Conta IG Grátis
                                        </a>
                                    </p>
                                    <section class="listContainer">
                                        <div class="stackContainer1">
                                            <p class="listTitle">Por que ter uma Conta IG?</p>
                                        </div>
                                        <div class="stackContainer8">
                                            <div class="stackContainer9">
                                                <i class="bi bi-check-lg checkColor"></i>
                                                <p class="listDescription">A Conta IG é gratuita, basta se cadastrar e acessar!</p>
                                            </div>
                                            <div class="stackContainer9">
                                                <i class="bi bi-check-lg checkColor"></i>
                                                <div class="listDescription">Com o Iodo Global+ você recebe novidades e muito mais.</div>
                                            </div>
                                        </div>
                                    </section>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>